{
  "name": "dsh-adaptive-plan",
  "version": "0.1.9",
  "description": "On-demand planning with configurable execution and planning models for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yaaaaaaa233/dsh-adaptive-plan.git"
  },
  "homepage": "https://github.com/Yaaaaaaa233/dsh-adaptive-plan#readme",
  "bugs": "https://github.com/Yaaaaaaa233/dsh-adaptive-plan/issues",
  "keywords": ["deepseek-harness", "dsh-plugin", "adaptive-planning", "model-routing"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./router": "./lib/router.js",
    "./defaults": "./lib/defaults.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "presets", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "engines": { "dsh": ">=0.1.6-alpha.1" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "devDependencies": {
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "MIT"
}
