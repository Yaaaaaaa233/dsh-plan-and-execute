{
  "name": "dsh-plan-and-execute",
  "version": "0.3.2",
  "description": "P&E for official DeepSeek Harness Desktop: configurable planning and execution models with fast and expert modes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yaaaaaaa233/dsh-plan-and-execute.git"
  },
  "homepage": "https://github.com/Yaaaaaaa233/dsh-plan-and-execute#readme",
  "bugs": "https://github.com/Yaaaaaaa233/dsh-plan-and-execute/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "adaptive-planning",
    "model-routing"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./router": "./lib/router.js",
    "./defaults": "./lib/defaults.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md"
  ],
  "dsh": {
    "engines": {
      "dsh": "0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/router.js && node --check lib/client.js && node --check lib/delegation.js"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
